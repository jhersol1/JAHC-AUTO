<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">
    <TextView android:id="@+id/txtStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Simulación Enter Passcode" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginBottom="12dp"/>
    <TextView android:id="@+id/txtDots" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="○ ○ ○ ○ ○ ○" android:textColor="#22C55E" android:textSize="22sp" android:layout_marginBottom="8dp"/>
    <TextView android:id="@+id/txtEntered" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#94A3B8" android:textSize="12sp" android:layout_marginBottom="16dp"/>
    <GridLayout android:layout_width="280dp" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="4" android:alignmentMode="alignBounds">
        <Button android:id="@+id/btn1" android:text="1" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp" style="@style/Widget.AppCompat.Button"/>
        <Button android:id="@+id/btn2" android:text="2&#10;ABC" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn3" android:text="3&#10;DEF" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn4" android:text="4&#10;GHI" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn5" android:text="5&#10;JKL" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn6" android:text="6&#10;MNO" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn7" android:text="7&#10;PQRS" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn8" android:text="8&#10;TUV" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn9" android:text="9&#10;WXYZ" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Space android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Button android:id="@+id/btn0" android:text="0" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
        <Space android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="6dp"/>
    </GridLayout>
    <Button android:id="@+id/btnClear" android:text="Borrar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
    <Button android:id="@+id/btnTestAuto" android:text="Probar Auto (Accesibilidad)" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
</LinearLayout>
